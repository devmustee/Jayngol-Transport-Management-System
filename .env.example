# Copy to .env.local for development.
DATABASE_URL=postgres://localhost:5432/jayngol_dev

# First Manager account, created by `npm run db:seed`.
# The seed refuses to use this example password in production.
SEED_MANAGER_NAME=Jayngol Manager
SEED_MANAGER_PHONE=08000000001
SEED_MANAGER_PASSWORD=dev-only-manager-pass

# Authorises the nightly job endpoint.
CRON_SECRET=replace-with-a-long-random-value
